<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddMobilierActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titlu_formular"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/denumire_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_denumire"
            android:inputType="text" />

        <EditText
            android:id="@+id/pret_ET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_pret"
            android:inputType="numberDecimal"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_material" />

        <Spinner
            android:id="@+id/material_SP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/materiale_array" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_confort"
            android:layout_marginTop="10dp" />

        <RatingBar
            android:id="@+id/calitate_RB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="3" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_stare"
            android:layout_marginTop="10dp" />

        <RadioGroup
            android:id="@+id/stare_RG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/nou_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radio_nou" />

            <RadioButton
                android:id="@+id/second_RB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/radio_second" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/montaj_CB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cb_montaj" />
        <Switch
            android:id="@+id/inStoc_SW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/sw_stoc" />

        <Button
            android:id="@+id/salveaza_BT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="culegeSiTrimiteDate"
            android:text="@string/btn_salveaza" />
    </LinearLayout>
</ScrollView>