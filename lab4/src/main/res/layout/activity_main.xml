<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnDeschide_BtT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideFormular"
        android:text="@string/btn_deschide_formular"/>

    <Button
        android:id="@+id/btnVeziLista_BT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:onClick="deschideLista"
        android:text="Vizualizeaza lista"/>

    <TextView
        android:id="@+id/rezultat_TV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="16sp"
        android:text="@string/tv_rezultat_initial"/>

</LinearLayout>